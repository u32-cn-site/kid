    "lesson": 67,
    "title": [
        "The weekend",
        "周末"
    ],
    "content": {
        "sentences": [
            [
                "Hello. Where were you at the butcher's?",
                "您好。刚才您在肉店里吗？"
            ],
            [
                "Yes. I was.",
                "是的，我在肉店里。"
            ],
            [
                "Were you at the butcher's, too?",
                "您也在肉店里吗？"
            ],
            [
                "No, I wasn't. I was at the greengrocer's.",
                "不，我不是。我在蔬菜水果店里。"
            ],
            [
                "How's Jimmy today?",
                "吉米今天怎么样？"
            ],
            [
                "He's very well, thank you.",
                "他很好，谢谢您。"
            ],
            [
                "Was he absent from school last week?",
                "上星期他没上学吧？"
            ],
            [
                "Yes, he was. He was absent on Monday, Tuesday, Wednesday and Thursday.",
                "是的，他没上学。他星期一、星期二、星期三和星期四没去上学。"
            ],
            [
                "How are you all keeping?",
                "你们身体都好吗？"
            ],
            [
                "Very well, thank you.",
                "很好，谢谢您。"
            ],
            [
                "We're going to spend three days in the country.",
                "我们打算到乡下去三天。"
            ],
            [
                "We're going to stay at my mother's for the weekend.",
                "我们打算在我母亲家度周末。"
            ],
            [
                "Friday, Saturday and Sunday in the country! Aren't you lucky!",
                "星期五、星期六和星期日在乡下过！你们真幸运啊！"
            ]
        ]
    },
